# 로컬 Docker Postgres (docker-compose.yml)
DATABASE_URL=postgres://jogan:jogan@localhost:5433/jogan

# Auth.js — `openssl rand -base64 32`
AUTH_SECRET=

# Google Cloud 콘솔 > OAuth 클라이언트 (README.md 참고)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 시드 사용자. Google 로그인에 쓸 본인 이메일
SEED_USER_EMAIL=

# 파이프라인 세션부터 사용
ANTHROPIC_API_KEY=

# next start로 로컬 프로덕션 빌드를 확인할 때 필요하다 (next dev는 자동으로 신뢰한다).
# Vercel 배포에서는 플랫폼이 호스트를 알려주므로 설정하지 않아도 된다.
AUTH_TRUST_HOST=true
