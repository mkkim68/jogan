# 로컬 Docker Postgres (docker-compose.yml)
DATABASE_URL=postgres://jogan:jogan@localhost:5433/jogan

# Auth.js — `openssl rand -base64 32`
AUTH_SECRET=

# Google Cloud 콘솔 > OAuth 클라이언트 (README.md 참고)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 시드 사용자. Google 로그인에 쓸 본인 이메일
SEED_USER_EMAIL=

# 파이프라인 세션부터 사용
ANTHROPIC_API_KEY=
